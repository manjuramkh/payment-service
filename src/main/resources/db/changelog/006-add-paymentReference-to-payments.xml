<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-add-paymentReference-to-payments" author="payment-service">

        <addColumn tableName="payments">
            <column name="payment_reference" type="VARCHAR(50)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="payments" columnName="payment_Reference"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
